# ─────────────────────────────────────────────────────────────────────────────
# Louella — single deployable (Next.js app + Nest API in one Vercel project)
#
# Copy to .env.local for local development. On Vercel these are set in
# Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# Must be Asia/Manila. The nightly auto-fill and every "today" boundary assume
# UTC+8; if unset, placeholder rows land on the wrong local date.
TZ=Asia/Manila

# Branch that owns central-kitchen production when an entry omits a branch.
PRODUCTION_BRANCH_ID=1

# ── Database ─────────────────────────────────────────────────────────────────
# Runtime queries go through Supabase's TRANSACTION pooler (port 6543).
# Serverless functions fan out into many short-lived instances, and the session
# pooler (5432) runs out of connections under any real traffic.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Migrations need a real session, which the transaction pooler cannot provide,
# so they use the session pooler (5432). Used only by `prisma migrate`.
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace_with_long_random_secret
JWT_REFRESH_SECRET=replace_with_long_random_secret

# The app and the API are now the SAME origin, so the refresh cookie is
# first-party. That removes the old SameSite=none requirement — which existed
# only because the Vercel frontend and the Cloud Run API were different sites.
# Lax is both safer and sufficient here.
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
# Leave empty. Same-origin cookies need no Domain attribute, and *.vercel.app
# is on the Public Suffix List, so browsers would reject one anyway.
COOKIE_DOMAIN=

# Same-origin browser calls need no CORS entry. Set this only for the Flutter
# app or any other cross-origin client.
ALLOWED_ORIGINS=

# ── Scheduled jobs ───────────────────────────────────────────────────────────
# There are none, and nothing to configure. The autofill jobs run on demand
# when an inventory, production, or material sheet is read — see
# AutofillOnDemandService. MANAGER-only manual triggers remain at POST /jobs/*.

# ── Storage ──────────────────────────────────────────────────────────────────
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=your-app-files-prod

# ── Push notifications ───────────────────────────────────────────────────────
# Use the inline JSON form on Vercel — there is no writable filesystem to hold
# a service-account file. Leave unset to disable push notifications.
FIREBASE_SERVICE_ACCOUNT=

# ── Frontend ─────────────────────────────────────────────────────────────────
# Leave unset. The API is same-origin and defaults to the relative /api/v1.
# Only set this to point a local build at a deployed API.
# NEXT_PUBLIC_API_URL=
