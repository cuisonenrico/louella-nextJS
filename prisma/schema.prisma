generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Serverless functions fan out into many short-lived instances, so runtime
  // queries go through Supabase's transaction pooler (port 6543) with
  // pgbouncer=true&connection_limit=1. Pointing this at the session pooler
  // (5432) exhausts the connection limit under any real traffic.
  url       = env("DATABASE_URL")
  // Migrations need a real session — the transaction pooler cannot run them.
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  VIEWER
  INVENTORY
  MANAGER
  ADMIN
}

enum FileStatus {
  PENDING
  UPLOADED
  PROCESSING
  FAILED
}

enum ProductType {
  BREAD
  CAKE
  SPECIAL
  MISCELLANEOUS
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum MeasurementUnit {
  KG
  G
  LITER
  ML
  PIECE
  DOZEN
  BAG
  SACHET
  CUP
  TBSP
  TSP
}

enum AdjustmentType {
  PULL_IN
  PULL_OUT
  ANOMALY
}

/// A branch transfer's state. Stock leaves the sender when the transfer is
/// sent (its PULL_OUT counts at once); the receiver's PULL_IN is only created
/// when the receiving branch accepts. Null on adjustments that are not
/// transfers.
enum TransferStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id                 Int            @id @default(autoincrement())
  email              String         @unique
  passwordHash       String
  role               UserRole       @default(USER)
  isActive           Boolean        @default(true)
  mustChangePassword Boolean        @default(false)
  failedLoginAttempts Int           @default(0)
  lockedUntil        DateTime?
  createdById        Int?
  branchId           Int?           @unique
  refreshTokens      RefreshToken[]
  files              File[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  inventoryEntries         Inventory[]         @relation("InventoryCreatedBy")
  inventoryEdits           Inventory[]         @relation("InventoryUpdatedBy")
  materialInventoryEntries MaterialInventory[] @relation("MaterialInventoryCreatedBy")
  materialInventoryEdits   MaterialInventory[] @relation("MaterialInventoryUpdatedBy")
  productionEntries        Production[]        @relation("ProductionCreatedBy")
  productionEdits          Production[]        @relation("ProductionUpdatedBy")
  auditEvents              AuditEvent[]
  productionOrders         ProductionOrder[]   @relation("ProductionOrderCreatedBy")
  inventoryAdjustments     InventoryAdjustment[] @relation("InventoryAdjustmentCreatedBy")
  inventoryAdjustmentEdits InventoryAdjustment[] @relation("InventoryAdjustmentUpdatedBy")
  transferResponses        InventoryAdjustment[] @relation("TransferRespondedBy")
  materialAdjustments      MaterialAdjustment[]  @relation("MaterialAdjustmentCreatedBy")
  deviceTokens             DeviceToken[]
  importLogs               ImportLog[]         @relation("ImportLogCreatedBy")

  createdBy      User?   @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers   User[]  @relation("UserCreatedBy")
  managedBranch  Branch? @relation("BranchManager", fields: [branchId], references: [id], onDelete: SetNull)

  rolePermissionsUpdated RoleFeaturePermission[] @relation("RolePermissionUpdater")
  userPermissions        UserFeaturePermission[] @relation("UserPermissions")
  userPermissionsUpdated UserFeaturePermission[] @relation("UserPermissionUpdater")

  employee Employee? @relation("EmployeeLogin")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  jti       String?  @unique
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model File {
  id        Int         @id @default(autoincrement())
  userId    Int
  s3Key     String
  filename  String
  status    FileStatus  @default(PENDING)
  createdAt DateTime    @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs Job[]

  @@index([userId])
}

model Job {
  id             Int       @id @default(autoincrement())
  fileId         Int
  status         JobStatus @default(PENDING)
  progress       Int       @default(0)
  resultLocation String?
  createdAt      DateTime  @default(now())

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
}

model Product {
  id        Int         @id @default(autoincrement())
  name      String
  type      ProductType @default(BREAD)
  sortOrder Int         @default(0)
  price     Decimal     @db.Decimal(10, 2) @default(0.00)
  isActive  Boolean     @default(true)
  date      DateTime    @default(now()) // product introduction / launch date
  createdAt DateTime    @default(now())
  deletedAt DateTime?                   // soft delete – null means active

  inventories  Inventory[]
  productions  Production[]
  recipe       Recipe?
  priceHistory ProductPriceHistory[]
  productionOrderItems ProductionOrderItem[]
  aliases      ProductAlias[]

  @@index([type, sortOrder])
}

// Maps a label as it appears in column A of an imported day sheet to a
// product. Sheet labels are ambiguous in two ways: the same word names a
// beverage and its bottle deposit (resolved by `section`), and in a few
// legacy cases two distinct SKUs share a name (resolved by `priceHint`).
// Price is a disambiguator only — never part of product identity, because
// prices are repriced constantly (see ProductPriceHistory).
/// NOTE: there is deliberately no @@unique([sheetLabel, section, priceHint])
/// here. Uniqueness for that triple is enforced solely in SQL by the
/// ProductAlias_lookup_key expression index in the migration — it keys on
/// lower(trim("sheetLabel")) (matching how LabelResolver normalizes labels,
/// so 'Litro' and 'litro' cannot both insert) plus COALESCE on the nullable
/// columns. A plain multi-column UNIQUE cannot do this,
/// because Postgres treats NULLs as distinct within a unique index (two rows
/// with the same sheetLabel and NULL section/priceHint would both insert
/// happily) and Prisma's @@unique has no way to express NULLS NOT DISTINCT.
/// Do not re-add @@unique here: Prisma's migration engine would then expect a
/// plain index named ProductAlias_sheetLabel_section_priceHint_key that will
/// never exist in the database, and propose creating it on every future
/// `prisma migrate dev`. Nothing in the codebase needs the compound key as a
/// named constraint — lookups use findMany, and alias seeding uses
/// `ON CONFLICT DO NOTHING` against the expression index directly.
model ProductAlias {
  id         Int      @id @default(autoincrement())
  productId  Int
  sheetLabel String   // store lowercased+trimmed, exactly as it appears in col A;
                      // LabelResolver normalizes on load, so a mis-cased row
                      // still matches, and ProductAlias_lookup_key keys on
                      // lower(trim(...)) so it cannot duplicate
  section    String?  // 'bote' for the deposit block; null = main body
  priceHint  Decimal? @db.Decimal(10, 2) // last-resort tie-break within one file
  notes      String?
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId]) // FK columns are not auto-indexed by Postgres
  @@index([sheetLabel])
}

model Branch {
  id        Int       @id @default(autoincrement())
  name      String
  address   String?
  phone     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete – null means active

  inventories      Inventory[]
  productions      Production[]
  productionOrders ProductionOrder[]
  importLogs       ImportLog[]
  manager          User?             @relation("BranchManager")
  employees        Employee[]
  branchExpenses   BranchExpense[]
  branchVale       BranchVale[]
  branchCashDays   BranchCashDay[]
}

// ---------------------------------------------------------------------------
// Granular Feature Permissions
// ---------------------------------------------------------------------------

model Feature {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  label       String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RoleFeaturePermission[]
  userPermissions UserFeaturePermission[]
}

model RoleFeaturePermission {
  id          Int      @id @default(autoincrement())
  role        UserRole
  featureKey  String
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  updatedById Int?

  feature   Feature @relation(fields: [featureKey], references: [key], onDelete: Cascade)
  updatedBy User?   @relation("RolePermissionUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([role, featureKey])
  @@index([role])
}

model UserFeaturePermission {
  id          Int      @id @default(autoincrement())
  userId      Int
  featureKey  String
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  updatedById Int?

  user      User    @relation("UserPermissions", fields: [userId], references: [id], onDelete: Cascade)
  feature   Feature @relation(fields: [featureKey], references: [key], onDelete: Cascade)
  updatedBy User?   @relation("UserPermissionUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([userId, featureKey])
  @@index([userId])
}

model Inventory {
  id          Int      @id @default(autoincrement())
  branchId    Int
  productId   Int
  createdById Int?     // user who submitted this record
  updatedById Int?     // user who last amended it — an edit is not an entry
  // quantity/delivery/leftover/reject are Int (whole pieces). If partial-unit
  // products are ever introduced, all four columns must migrate to Decimal.
  quantity    Int      @default(0) // total pieces produced / available for the day
  delivery    Int      @default(0) // pieces delivered from production to this branch
  leftover    Int      @default(0) // unsold pieces at end of day
  reject      Int      @default(0) // damaged / rejected pieces
  date        DateTime @db.Date
  notes       String?
  isAutoGenerated Boolean @default(false) // true = created by the daily CRON job (placeholder)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?             // soft delete – null means active

  branch      Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product     Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy   User?                 @relation("InventoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?                 @relation("InventoryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  adjustments InventoryAdjustment[]
  incomingTransfers InventoryAdjustment[] @relation("TransferDestination")

  @@unique([branchId, productId, date])
  @@index([branchId])
  @@index([productId])
  @@index([date])
  @@index([createdById])
  @@index([updatedById])
  @@index([branchId, date])
  @@index([productId, date])
}

// ---------------------------------------------------------------------------
// Inventory Adjustments
// ---------------------------------------------------------------------------

model InventoryAdjustment {
  id                  Int            @id @default(autoincrement())
  inventoryId         Int
  type                AdjustmentType
  value               Int            // magnitude, always positive; direction comes from `type` (see computeAdjSum)
  notes               String?
  linkedAdjustmentId  Int?           // paired transfer counterpart (PULL_OUT ↔ PULL_IN)
  createdById         Int?           // user who entered this adjustment
  updatedById         Int?           // user who last revised it
  // Transfers only. On the sender's PULL_OUT: where the stock is going, and
  // whether the receiving branch has accepted it (see TransferStatus).
  transferStatus        TransferStatus?
  transferToInventoryId Int?
  respondedById         Int?      // receiver who accepted or rejected
  respondedAt           DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?

  inventory        Inventory            @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  transferTo       Inventory?           @relation("TransferDestination", fields: [transferToInventoryId], references: [id], onDelete: SetNull)
  respondedBy      User?                @relation("TransferRespondedBy", fields: [respondedById], references: [id], onDelete: SetNull)
  linkedAdjustment InventoryAdjustment? @relation("TransferLink", fields: [linkedAdjustmentId], references: [id], onDelete: SetNull)
  linkedBy         InventoryAdjustment[] @relation("TransferLink")
  createdBy        User?                @relation("InventoryAdjustmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy        User?                @relation("InventoryAdjustmentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([inventoryId])
  @@index([linkedAdjustmentId])
  @@index([createdById])
  @@index([updatedById])
  @@index([transferToInventoryId])
  @@index([transferStatus])
  @@index([respondedById])
}

// ---------------------------------------------------------------------------
// Production
// ---------------------------------------------------------------------------

model Production {
  id          Int      @id @default(autoincrement())
  branchId    Int
  productId   Int
  createdById Int?     // user who submitted this record
  updatedById Int?     // user who last changed it
  yield       Int      @default(0) // actual pieces produced that day (independent of recipe yield)
  date        DateTime @db.Date
  notes       String?
  isAutoGenerated Boolean @default(false) // true = an autofill placeholder
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Soft delete, like every operational table. The unique key below ignores
  // it, so re-entering a deleted day restores the row (see ProductionService).
  deletedAt   DateTime?

  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("ProductionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?   @relation("ProductionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([branchId, productId, date])
  @@index([branchId])
  @@index([productId])
  @@index([date])
  @@index([createdById])
  @@index([updatedById])
  @@index([branchId, date])
  @@index([productId, date])
}

// ---------------------------------------------------------------------------
// Production Orders
// ---------------------------------------------------------------------------

enum ProductionOrderStatus {
  DRAFT
  FINALIZED
  CANCELLED
}

model ProductionOrder {
  id          Int                   @id @default(autoincrement())
  branchId    Int?
  date        DateTime              @db.Date
  status      ProductionOrderStatus @default(DRAFT)
  notes       String?
  createdById Int?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  deletedAt   DateTime?

  branch    Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdBy User?                @relation("ProductionOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items     ProductionOrderItem[]

  @@index([branchId])
  @@index([branchId, date])
  @@index([date])
  @@index([status])
  @@index([createdById])
}

model ProductionOrderItem {
  id                Int @id @default(autoincrement())
  productionOrderId Int
  productId         Int
  yield             Int @default(0)

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productionOrderId, productId])
  @@index([productionOrderId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Materials & Recipes
// ---------------------------------------------------------------------------

model Material {
  id           Int             @id @default(autoincrement())
  name         String
  unit         MeasurementUnit // base unit for stock tracking and pricing
  pricePerUnit Decimal         @db.Decimal(10, 4) @default(0.0000)
  reorderLevel Decimal         @db.Decimal(10, 4) @default(0.0000) // alert threshold – restock when stock drops below this
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?       // soft delete – null means active

  recipeItems         RecipeItem[]
  recipeVersionItems  RecipeVersionItem[]
  materialInventories MaterialInventory[]
  priceHistory        MaterialPriceHistory[]
}

model Recipe {
  id          Int      @id @default(autoincrement())
  productId   Int      @unique // enforces 1:1 with Product
  recipeYield Decimal   @db.Decimal(14, 4) @default(1) // number of product units produced per batch of this recipe
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?             // soft delete – null means active

  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  recipeItems RecipeItem[]
  versions    RecipeVersion[]
}

/// An immutable snapshot of a recipe, in force from `effectiveFrom` (a Manila
/// calendar day) until the next version. RecipeItem is the recipe as it stands
/// now; versions are its history, appended on every create, edit, delete
/// (`retired`) and revive. Consumption and costing for day D use the latest
/// version effective on or before D — so editing a recipe today no longer
/// rewrites what last month's production consumed or cost.
model RecipeVersion {
  id            Int      @id @default(autoincrement())
  recipeId      Int
  version       Int      // 1, 2, 3… per recipe
  effectiveFrom DateTime @db.Date
  recipeYield   Decimal  @db.Decimal(14, 4)
  retired       Boolean  @default(false) // recipe deleted from this day on
  createdAt     DateTime @default(now())

  recipe Recipe              @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  items  RecipeVersionItem[]

  @@unique([recipeId, version])
  @@index([recipeId, effectiveFrom])
}

model RecipeVersionItem {
  id         Int             @id @default(autoincrement())
  versionId  Int
  materialId Int
  quantity   Decimal         @db.Decimal(14, 4)
  unit       MeasurementUnit

  version  RecipeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  material Material      @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@index([materialId])
}

model RecipeItem {
  id         Int             @id @default(autoincrement())
  recipeId   Int
  materialId Int
  quantity   Decimal         @db.Decimal(14, 4) // how much of the material is required per batch
  unit       MeasurementUnit // unit for this recipe step – may differ from material base unit
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  recipe   Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([recipeId, materialId])
  @@index([recipeId])
  @@index([materialId])
}

// MaterialInventory is keyed on (materialId, date) with NO branchId.
// This is intentional: Louella has a single central kitchen, so raw-material
// stock is tracked globally rather than per-branch. Do NOT add a branchId
// column here — if the business ever opens a second kitchen, model that as a
// separate entity rather than cramming it into this table.
model MaterialInventory {
  id          Int       @id @default(autoincrement())
  materialId  Int
  // @db.Date, matching Inventory.date. As a bare DateTime this column stored
  // the time component, so a request carrying one created a *second* card for
  // the same day that @@unique([materialId, date]) could not catch. Writes are
  // normalised through toUtcDay as well; this makes the column itself incapable
  // of holding the bad value.
  date        DateTime  @db.Date // one stock-card per material per day
  // Quantities are exact decimals (4 dp: 0.0001 kg = 0.1 g). They were
  // `double precision`, and every production edit incremented `used` by a
  // binary fraction, so residue built up with each save. Writers round to the
  // scale before writing (common/utils/decimal.util.ts).
  supplierId  Int?
  createdById Int?
  updatedById Int?
  batchNumber String?
  expiresAt   DateTime?
  quantity    Decimal   @db.Decimal(14, 4) @default(0) // opening stock (carried over from previous day)
  delivery    Decimal   @db.Decimal(14, 4) @default(0) // received on this day
  used        Decimal   @db.Decimal(14, 4) @default(0) // consumed by production (auto-updated)
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // soft delete – null means active

  material    Material            @relation(fields: [materialId], references: [id], onDelete: Cascade)
  supplier    Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdBy   User?               @relation("MaterialInventoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?               @relation("MaterialInventoryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  adjustments MaterialAdjustment[]

  // The unique key deliberately excludes deletedAt, matching Inventory: a
  // deleted card still owns its (material, date) slot, and re-entering that day
  // clears the tombstone rather than inserting a second card. See
  // MaterialInventoryService.create.
  @@unique([materialId, date])
  @@index([date])
  @@index([supplierId])
  @@index([createdById])
  @@index([updatedById])
}

// ---------------------------------------------------------------------------
// Material Adjustments (losses, spoilage, corrections)
//
// Two deliberate differences from InventoryAdjustment, both worth knowing before
// you "fix" one of them:
//
//   - `value` is a decimal here, Int there. Materials are weighed (2.5 KG of flour);
//     finished goods are counted in whole pieces.
//   - There is no update endpoint and no transfer pairing. Material stock is
//     global to the central kitchen — MaterialInventory has no branchId — so
//     there is nowhere to transfer *to*, and a wrong entry is deleted and
//     re-added rather than edited.
// ---------------------------------------------------------------------------

model MaterialAdjustment {
  id                  Int            @id @default(autoincrement())
  materialInventoryId Int
  type                AdjustmentType // PULL_IN = restock, PULL_OUT = transfer out, ANOMALY = loss/spoilage
  value               Decimal        @db.Decimal(14, 4)// magnitude (always positive; direction conveyed by type)
  notes               String?
  createdById         Int?           // user who entered this adjustment
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?

  materialInventory MaterialInventory @relation(fields: [materialInventoryId], references: [id], onDelete: Cascade)
  createdBy         User?             @relation("MaterialAdjustmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([materialInventoryId])
  @@index([createdById])
}

// ---------------------------------------------------------------------------
// Suppliers & Price History
// ---------------------------------------------------------------------------

model Supplier {
  id        Int       @id @default(autoincrement())
  name      String
  contact   String?   // contact person name
  phone     String?
  email     String?
  address   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete – null means active

  materialInventories MaterialInventory[]
  priceHistory        MaterialPriceHistory[]
}

model MaterialPriceHistory {
  id           Int       @id @default(autoincrement())
  materialId   Int
  supplierId   Int?      // supplier this price was quoted / paid from
  pricePerUnit Decimal  @db.Decimal(10, 4)
  effectiveAt  DateTime // date from which this price applies
  createdAt    DateTime @default(now())

  material Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([materialId])
  @@index([effectiveAt])
  @@index([materialId, effectiveAt])
}

model ProductPriceHistory {
  id          Int      @id @default(autoincrement())
  productId   Int
  price       Decimal  @db.Decimal(10, 2)
  effectiveAt DateTime // date from which this price applies
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([effectiveAt])
  @@index([productId, effectiveAt])
}

// ---------------------------------------------------------------------------
// Unit Conversions
// ---------------------------------------------------------------------------

model UnitConversion {
  id       Int             @id @default(autoincrement())
  fromUnit MeasurementUnit
  toUnit   MeasurementUnit
  // Multiply a quantity in fromUnit by this factor to get the quantity in toUnit.
  // e.g. fromUnit=KG, toUnit=G, factor=1000  →  1 kg * 1000 = 1000 g
  // The inverse pair (G→KG, factor=0.001) is always stored alongside this record.
  factor   Decimal         @db.Decimal(18, 9)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fromUnit, toUnit])
  @@index([fromUnit]) 
  @@index([toUnit])
}

// ---------------------------------------------------------------------------
// Notifications — FCM Device Tokens
// ---------------------------------------------------------------------------

model DeviceToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  platform  String   @default("web") // web | android | ios
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Import Log — audit trail for Excel/CSV imports
// ---------------------------------------------------------------------------

model ImportLog {
  id           Int      @id @default(autoincrement())
  branchId     Int
  fileName     String
  fileHash     String   // SHA-256 hex of the raw file buffer
  importedBy   Int?
  importedAt   DateTime @default(now())
  sheetCount   Int      @default(0)
  rowCount     Int      @default(0)
  skippedCount Int      @default(0)
  status       String   @default("SUCCESS") // SUCCESS | PARTIAL
  notes        String?
  // Soft delete: "deleting" a log releases its file hash for a corrected
  // re-import, but the record of the earlier import stays.
  deletedAt    DateTime?

  branch         Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  importedByUser User?  @relation("ImportLogCreatedBy", fields: [importedBy], references: [id], onDelete: SetNull)

  /// NOTE: no @@unique([branchId, fileHash]). One file per branch is enforced
  /// only among *live* logs, by the partial index ImportLog_live_file_key
  /// (`WHERE "deletedAt" IS NULL`) in migration 20260923110000, which Prisma
  /// cannot express. A plain unique key would make a deleted log block the
  /// re-import it was deleted to allow. Same technique as ProductAlias.
  @@index([branchId, fileHash])
  @@index([importedAt])
}

// ---------------------------------------------------------------------------
// Change history
// ---------------------------------------------------------------------------

/// One row per change to a stock figure: what changed, from what, to what,
/// who, and when. Written inside the same transaction as the change, so the
/// history can never disagree with the data. `changes` maps each changed field
/// to [before, after]; `action` is create | update | delete | restore |
/// carry-forward (a system rewrite of an opening, caused by an earlier day's
/// correction, with the causing user where known).
model AuditEvent {
  id       Int      @id @default(autoincrement())
  entity   String   // Inventory | MaterialInventory | Production
  entityId Int
  action   String
  changes  Json
  userId   Int?
  at       DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId, at])
  @@index([userId])
  @@index([at])
}

// ---------------------------------------------------------------------------
// Job Runs — execution log for scheduled/manual background jobs
// ---------------------------------------------------------------------------

model JobRun {
  id         Int       @id @default(autoincrement())
  // inventory-autofill | inventory-autofill-range | material-autofill |
  // material-autofill-range | morning-init | boot-backfill
  jobName    String
  trigger    String    @default("cron") // cron | manual | boot
  targetDate DateTime? @db.Date
  status     JobStatus @default(RUNNING)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  result     Json?     // raw job return, e.g. {"inventoryCreated":42,"productionCreated":42}
  error      String?

  @@index([jobName, startedAt])
}

// ---------------------------------------------------------------------------
// Idempotency keys
// ---------------------------------------------------------------------------

/// One row per (user, Idempotency-Key) on endpoints marked @Idempotent().
/// Reserved before the handler runs, so a resend of the same submission (a
/// double click, a retried request) replays the first response instead of
/// booking a second pull-out. `statusCode` is null while the first request is
/// still running. Rows older than a day are purged as new keys arrive.
model IdempotencyKey {
  id           Int      @id @default(autoincrement())
  userId       Int
  key          String
  route        String   // method + route pattern, e.g. "POST /inventory-adjustments/transfer"
  requestHash  String   // SHA-256 of route params + body
  statusCode   Int?
  responseBody Json?
  createdAt    DateTime @default(now())

  @@unique([userId, key])
  @@index([createdAt])
}

// ─── Payroll ─────────────────────────────────────────────────────────────────
// Admin-only. See docs/superpowers/specs/2026-09-24-payroll-design.md.
// Actor columns (createdById, finalizedById, …) are plain ids without a foreign
// key, like IdempotencyKey.userId, so User does not grow a back-relation each.
// Partial unique indexes and the rest-day CHECK live in the migration SQL:
// Prisma cannot express them (see the note on ImportLog).

enum PayrollAdjustmentKind {
  ADDITION
  DEDUCTION
}

enum PayrollAdjustmentCategory {
  OVERTIME
  BONUS
  HOLIDAY
  ALLOWANCE
  OFFENSE
  OTHER
}

enum PayrollRunStatus {
  FINALIZED
  PAID
  VOIDED
}

enum PayslipLineType {
  BASIC
  ADDITION
  DEDUCTION
  EMPLOYER_SHARE
}

/// A job title (Baker, Cashier…). Unrelated to UserRole, which is login access.
model JobRole {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]
}

/// A person on payroll. The login, if any, is the optional `user`.
model Employee {
  id          Int       @id @default(autoincrement())
  firstName   String
  lastName    String
  jobRoleId   Int
  branchId    Int?      // null = central kitchen / unassigned; not an access control
  restDays    Int[]     @default([0]) // weekdays off, 0 = Sunday … 6 = Saturday
  hiredOn     DateTime  @db.Date
  separatedOn DateTime? @db.Date
  userId      Int?      @unique
  phone       String?
  address     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  jobRole             JobRole                  @relation(fields: [jobRoleId], references: [id])
  branch              Branch?                  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user                User?                    @relation("EmployeeLogin", fields: [userId], references: [id], onDelete: SetNull)
  rates               EmployeeRate[]
  recurringDeductions RecurringDeduction[]
  absences            Absence[]
  adjustments         PayrollAdjustment[]
  skips               RecurringDeductionSkip[]
  payslips            Payslip[]
  vale                BranchVale[]

  @@index([jobRoleId])
  @@index([branchId])
}

/// Daily-rate history. A raise is a new row, never an edit.
model EmployeeRate {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  dailyRate   Decimal   @db.Decimal(12, 2)
  effectiveOn DateTime  @db.Date
  createdById Int?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, effectiveOn])
}

/// SSS, PhilHealth, Pag-IBIG or custom. Monthly amounts, taken on the 1–15 cutoff.
model RecurringDeduction {
  id            Int      @id @default(autoincrement())
  employeeId    Int
  name          String
  employeeShare Decimal  @db.Decimal(12, 2)
  employerShare Decimal  @default(0) @db.Decimal(12, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee Employee                 @relation(fields: [employeeId], references: [id])
  skips    RecurringDeductionSkip[]

  @@index([employeeId])
}

/// A working day the employee did not work. Whole days only.
model Absence {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  date        DateTime  @db.Date
  note        String?
  createdById Int?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([date])
  @@index([employeeId, date])
}

/// A one-off addition or deduction on one cutoff.
model PayrollAdjustment {
  id          Int                       @id @default(autoincrement())
  employeeId  Int
  periodStart DateTime                  @db.Date
  kind        PayrollAdjustmentKind
  category    PayrollAdjustmentCategory
  description String
  amount      Decimal                   @db.Decimal(12, 2) // always positive; sign comes from kind
  createdById Int?
  createdAt   DateTime                  @default(now())
  deletedAt   DateTime?

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([periodStart])
  @@index([employeeId])
}

/// "Do not take this recurring deduction on this cutoff."
model RecurringDeductionSkip {
  id                   Int       @id @default(autoincrement())
  employeeId           Int
  recurringDeductionId Int
  periodStart          DateTime  @db.Date
  createdById          Int?
  createdAt            DateTime  @default(now())
  deletedAt            DateTime?

  employee           Employee           @relation(fields: [employeeId], references: [id])
  recurringDeduction RecurringDeduction @relation(fields: [recurringDeductionId], references: [id])

  @@index([periodStart])
}

/// A finalized cutoff. At most one non-VOIDED run per periodStart.
model PayrollRun {
  id                 Int              @id @default(autoincrement())
  periodStart        DateTime         @db.Date
  periodEnd          DateTime         @db.Date
  status             PayrollRunStatus @default(FINALIZED)
  employeeCount      Int
  totalNetPay        Decimal          @db.Decimal(14, 2)
  totalEmployerShare Decimal          @db.Decimal(14, 2)
  finalizedAt        DateTime         @default(now())
  finalizedById      Int?
  paidAt             DateTime?
  paidById           Int?
  voidedAt           DateTime?
  voidedById         Int?
  voidReason         String?

  payslips Payslip[]

  @@index([periodStart])
}

/// One employee's frozen payslip. Prints from its own columns and lines only.
model Payslip {
  id                 Int     @id @default(autoincrement())
  runId              Int
  employeeId         Int
  employeeName       String
  jobRoleName        String
  branchName         String?
  workingDays        Int
  absenceDays        Int
  daysWorked         Int
  basicPay           Decimal @db.Decimal(12, 2)
  totalAdditions     Decimal @db.Decimal(12, 2)
  totalDeductions    Decimal @db.Decimal(12, 2)
  netPay             Decimal @db.Decimal(12, 2)
  totalEmployerShare Decimal @db.Decimal(12, 2)

  run      PayrollRun    @relation(fields: [runId], references: [id])
  employee Employee      @relation(fields: [employeeId], references: [id])
  lines    PayslipLine[]

  @@unique([runId, employeeId])
  @@index([employeeId])
}

model PayslipLine {
  id         Int             @id @default(autoincrement())
  payslipId  Int
  sortOrder  Int
  type       PayslipLineType
  label      String
  quantity   Decimal?        @db.Decimal(12, 2)
  rate       Decimal?        @db.Decimal(12, 2)
  amount     Decimal         @db.Decimal(12, 2)
  sourceType String?         // EmployeeRate | PayrollAdjustment | RecurringDeduction | BranchVale
  sourceId   Int?

  payslip Payslip @relation(fields: [payslipId], references: [id])

  @@index([payslipId])
}

// ─── Branch cash ─────────────────────────────────────────────────────────────
// Drawer expenses, vale (cash advances to staff) and the counted cash, per
// branch per Manila day. See docs/superpowers/specs/2026-09-24-branch-cash-design.md.
// Sales is never stored here: it is derived from inventory by SalesService.
// Actor columns are plain ids without a foreign key, as in payroll.

enum BranchCashDayStatus {
  OPEN
  VERIFIED
}

model ExpenseCategory {
  id           Int       @id @default(autoincrement())
  name         String    @unique
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  requiresNote Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  expenses BranchExpense[]
}

model BranchExpense {
  id          Int       @id @default(autoincrement())
  branchId    Int
  date        DateTime  @db.Date
  categoryId  Int
  amount      Decimal   @db.Decimal(12, 2)
  note        String?
  createdById Int
  updatedById Int?
  deletedById Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  branch   Branch          @relation(fields: [branchId], references: [id])
  category ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@index([branchId, date])
  @@index([categoryId])
}

model BranchVale {
  id          Int       @id @default(autoincrement())
  branchId    Int
  date        DateTime  @db.Date
  employeeId  Int
  amount      Decimal   @db.Decimal(12, 2)
  note        String?
  createdById Int
  updatedById Int?
  deletedById Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  branch   Branch   @relation(fields: [branchId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([branchId, date])
  @@index([employeeId, date])
}

model BranchCashDay {
  id               Int                 @id @default(autoincrement())
  branchId         Int
  date             DateTime            @db.Date
  actualCash       Decimal?            @db.Decimal(12, 2)
  note             String?
  status           BranchCashDayStatus @default(OPEN)
  verifiedById     Int?
  verifiedAt       DateTime?
  // Written at verify, cleared at reopen. Lets a verified day show that sales
  // moved afterwards (a late inventory correction) instead of silently changing.
  salesAtVerify    Decimal?            @db.Decimal(12, 2)
  expensesAtVerify Decimal?            @db.Decimal(12, 2)
  valeAtVerify     Decimal?            @db.Decimal(12, 2)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([branchId, date])
}
